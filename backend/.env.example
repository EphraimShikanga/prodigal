DATABASE_URL=postgresql://argus:argus@localhost:5432/argus?schema=public
PORT=3000
THROTTLER_TTL=60000
THROTTLER_LIMIT=10

# Base URL of the ARGUS-KE backend API (used for generating image URLs)
API_BASE_URL=http://localhost:3000

# Base URL of the ARGUS-KE ML face-recognition service (FastAPI).
