# Keep the build context small and the image clean.

# Virtual environments
venv/
.venv/
env/
ENV/

# Python caches / artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Tests (not needed in the runtime image)
tests/

# Docs and markdown
*.md

# Local env / secrets
.env
.env.*
!.env.example

# Version control and editor cruft
.git/
.gitignore
.gitkeep
.idea/
.vscode/

# Docker meta
Dockerfile
docker-compose.yml
.dockerignore
