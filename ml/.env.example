# ARGUS-KE ML Service - example environment configuration.
#
# Copy to `.env` and adjust. All variables use the ARGUS_ prefix and map to
# fields on app.config.Settings. Values shown are the in-code defaults.

# --- Service identity ---
# ARGUS_APP_NAME="ARGUS-KE ML Service"
# ARGUS_VERSION="0.1.0"
# ARGUS_API_PREFIX="/api/v1"

# --- Backend selection ---
# Face engine: auto | insightface | stub
#   auto         -> try InsightFace, fall back to the deterministic stub.
#   insightface  -> require the real buffalo_l model (needs requirements-ml.txt).
#   stub         -> zero-ML deterministic engine (great for dev/tests/CI).
ARGUS_ML_BACKEND=auto

# Vector store: auto | pgvector | memory
#   auto      -> pgvector when ARGUS_DATABASE_URL is set, else in-memory.
#   pgvector  -> Postgres + pgvector (needs requirements-ml.txt: psycopg, pgvector).
#   memory    -> in-process list (non-persistent; lost on restart).
ARGUS_STORE_BACKEND=auto

# --- Matching / detection tuning ---
# ARGUS_EMBEDDING_DIM=512
# ARGUS_MATCH_THRESHOLD=0.35   # cosine similarity; >= means "match"
# ARGUS_MATCH_TOP_K=5
# ARGUS_MIN_DET_SCORE=0.5
# ARGUS_MAX_IMAGE_MB=10

# --- Database (pgvector) ---
# Required when ARGUS_STORE_BACKEND=pgvector (or auto + you want persistence).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# ARGUS_DATABASE_URL=postgresql://argus:argus@localhost:5432/argus

# --- CORS ---
# JSON array of allowed origins (default ["*"]). Tighten for production.
# ARGUS_CORS_ORIGINS=["https://app.example.com"]
